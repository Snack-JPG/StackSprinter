# StackSprinter Environment Variables
# Copy this to .env and fill in your actual tokens

# Supabase - Get from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here

# Vercel - Get from https://vercel.com/account/tokens  
VERCEL_TOKEN=your_vercel_token_here

# GitHub - Get from https://github.com/settings/tokens (repo scope required)
GH_TOKEN=your_github_token_here

# Optional: For GitHub Actions OIDC (advanced setup)
# ACTIONS_ID_TOKEN_REQUEST_TOKEN=auto_provided_in_actions

# Optional: Override default settings
# STACKSPRINTER_DEFAULT_REGION=us-east-1
# STACKSPRINTER_DEFAULT_ORG=your-default-org