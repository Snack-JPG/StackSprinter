# ====================================
# ArbitrageMarkets Environment Config
# ====================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ====================================
# Application
# ====================================
NODE_ENV=development
PORT=3000
BACKEND_PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# API base URL
API_BASE_URL=http://localhost:3001

# ====================================
# Kalshi API
# ====================================
# Get credentials from: https://kalshi.com/settings/api
# Documentation: https://docs.kalshi.com

KALSHI_API_KEY=your_kalshi_api_key_here
KALSHI_API_SECRET=your_kalshi_api_secret_here

# Use demo environment for testing (optional)
# KALSHI_API_URL=https://demo-api.kalshi.co/trade-api/v2
KALSHI_API_URL=https://api.elections.kalshi.com/trade-api/v2

# ====================================
# Polymarket API
# ====================================
# No authentication required for market data
# Documentation: https://docs.polymarket.com

POLYMARKET_API_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# ====================================
# OpenAI API
# ====================================
# Required for market matching via embeddings
# Get key from: https://platform.openai.com/api-keys

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=8191

# ====================================
# Database (PostgreSQL)
# ====================================
# Local development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arbitrage_markets

# Production (example - use your actual connection string)
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# ====================================
# Redis Cache
# ====================================
# Local development
REDIS_URL=redis://localhost:6379

# Production (example)
# REDIS_URL=redis://:password@host:6379

# Redis key prefix
REDIS_KEY_PREFIX=arbitrage:

# Cache TTL settings (in seconds)
CACHE_TTL_MARKETS=60
CACHE_TTL_OPPORTUNITIES=30
CACHE_TTL_USER_PREFS=300

# ====================================
# Authentication
# ====================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_minimum_32_characters_recommended

# JWT expiration (e.g., "7d", "24h", "30m")
JWT_EXPIRES_IN=7d

# Encryption key for storing user API credentials
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_encryption_key_64_hex_characters_for_aes256

# ====================================
# Email Alerts (Optional)
# ====================================
# SMTP configuration for email alerts

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Email "From" address
# EMAIL_FROM=alerts@arbitragemarkets.com

# ====================================
# WebSocket
# ====================================
WS_PORT=3001
WS_PATH=/ws

# Connection limits
WS_MAX_CONNECTIONS_PER_IP=5
WS_MESSAGE_RATE_LIMIT=50

# ====================================
# Rate Limiting
# ====================================
# API rate limiting (requests per minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ====================================
# Cron Jobs
# ====================================
# Market data fetching interval (cron syntax)
# Default: every 30 seconds
CRON_FETCH_MARKETS=*/30 * * * * *

# Opportunity scanning interval
# Default: every 15 seconds
CRON_SCAN_OPPORTUNITIES=*/15 * * * * *

# Cleanup old data interval
# Default: daily at 2 AM
CRON_CLEANUP=0 2 * * *

# ====================================
# Logging
# ====================================
LOG_LEVEL=info
LOG_FORMAT=json

# Log file paths (optional - defaults to console)
# LOG_FILE_PATH=./logs/app.log
# LOG_ERROR_FILE_PATH=./logs/error.log

# ====================================
# Monitoring (Optional)
# ====================================
# Sentry for error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# DataDog APM
# DD_API_KEY=your_datadog_api_key
# DD_SERVICE=arbitrage-markets
# DD_ENV=production

# ====================================
# Feature Flags
# ====================================
# Enable/disable features
FEATURE_EMAIL_ALERTS=false
FEATURE_WEBSOCKET=true
FEATURE_AUTO_TRADING=false
FEATURE_ADVANCED_ANALYTICS=false

# ====================================
# Alert Thresholds
# ====================================
# Minimum profit margin to trigger alerts (percentage)
DEFAULT_MIN_PROFIT_MARGIN=2.0

# Minimum liquidity on both sides (USD)
MIN_LIQUIDITY_THRESHOLD=1000

# Maximum opportunity age before expiration (seconds)
OPPORTUNITY_MAX_AGE=300

# ====================================
# External Services
# ====================================
# Webhook URLs for notifications (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK

# ====================================
# Development/Testing
# ====================================
# Enable debug mode
DEBUG=false

# Mock external APIs (for testing without credentials)
MOCK_KALSHI_API=false
MOCK_POLYMARKET_API=false
MOCK_OPENAI_API=false

# Seed database with test data on startup
SEED_DATABASE=false
