# Server Configuration
NODE_ENV=development
PORT=3001

# Kalshi API Configuration
KALSHI_API_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_EMAIL=your-kalshi-email@example.com
KALSHI_PASSWORD=your-kalshi-password

# Polymarket API Configuration (TODO: Add when implementing)
POLYMARKET_API_BASE_URL=https://clob.polymarket.com
POLYMARKET_API_KEY=your-polymarket-api-key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arbitrage_markets
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database URL (for Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arbitrage_markets"
# Production examples:
# Railway: postgresql://user:pass@containers-us-west-xxx.railway.app:5432/railway
# Render: postgresql://user:pass@dpg-xxx-a.oregon-postgres.render.com/dbname
# Supabase: postgresql://postgres:[PASSWORD]@db.xxx.supabase.co:5432/postgres

# Application Settings
MARKET_FETCH_INTERVAL_MS=30000
ARBITRAGE_MIN_PROFIT_PERCENT=2.0
LOG_LEVEL=info

# CORS Settings
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
KALSHI_RATE_LIMIT_PER_SECOND=10
POLYMARKET_RATE_LIMIT_PER_SECOND=10
