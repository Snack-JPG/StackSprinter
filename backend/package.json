{
  "name": "arbitrage-markets-backend",
  "version": "1.0.0",
  "description": "Real-time arbitrage detection platform between Kalshi and Polymarket prediction markets",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "arbitrage",
    "prediction-markets",
    "kalshi",
    "polymarket",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.9.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "ws": "^8.16.0",
    "socket.io": "^4.6.1",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "axios": "^1.6.7",
    "dotenv": "^16.4.1",
    "zod": "^3.22.4",
    "winston": "^3.11.0",
    "axios-rate-limit": "^1.3.0",
    "bottleneck": "^2.19.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.10",
    "@types/node": "^20.11.16",
    "@types/pg": "^8.11.0",
    "prisma": "^5.9.1",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
